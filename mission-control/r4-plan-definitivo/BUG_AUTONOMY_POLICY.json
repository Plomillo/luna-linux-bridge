{
  "schema": "LOUKSNA_PUAC2_BANAL_BUG_AUTONOMY_POLICY/1.0",
  "status": "AUTHORIZED_OPERATIONAL_POLICY",
  "authority": "Louksna.md",
  "assurance": "PUAC2.md",
  "plan": "PLAN DEFINITIVO",
  "scope": "CURRENT_AUTHORIZED_MISSION_ONLY",
  "doctrine": "EXTEND_DO_NOT_REPLACE",
  "failure_posture": "FAIL_CLOSED",
  "purpose": "Allow autonomous correction of trivial deterministic implementation defects without redoing already-certified material work or requesting repeated human approval.",
  "banal_bug_definition": {
    "required_all": [
      "exact_failure_evidence_exists",
      "root_cause_is_deterministic_and_localized",
      "no_data_integrity_failure",
      "no_hash_mismatch_of_protected_payload",
      "no_scope_expansion",
      "no_authority_change",
      "no_privilege_expansion",
      "no_new_destructive_operation",
      "no_legal_or_license_gate",
      "minimum_corrective_delta_is_testable"
    ],
    "examples": [
      "filename_or_path_mismatch",
      "read_only_privilege_boundary_mismatch",
      "quoting_or_shell_redirection_bug",
      "environment_variable_or_runtime_path_bug",
      "deterministic_parser_or_validator_false_negative",
      "workflow_wiring_or_artifact_name_mismatch",
      "privilege_propagation_mismatch",
      "root_owned_tree_verifier_permission_mismatch"
    ]
  },
  "autonomous_remediation_pipeline": [
    "CAPTURE_FAILURE",
    "CLASSIFY",
    "PROVE_BANAL_SCOPE",
    "CHECKPOINT_CURRENT_VALID_STATE",
    "PATCH_MINIMUM_DELTA",
    "STATIC_TEST",
    "NEGATIVE_TESTS_WHERE_APPLICABLE",
    "AUDIT",
    "TRACE",
    "G23",
    "G24",
    "RERUN_ONLY_FAILED_OR_DOWNSTREAM_STEP",
    "NON_REGRESSION",
    "CONTINUE"
  ],
  "hard_rules": {
    "repeat_certified_work": false,
    "repeat_hash_verified_bulk_copy": false,
    "repeat_partition_migration": false,
    "debian_redownload": false,
    "debian_reinstall": false,
    "kde_redownload": false,
    "kde_reinstall": false,
    "bypass_g23": false,
    "bypass_g24": false,
    "certification_propagation": false,
    "silent_scope_expansion": false,
    "silent_privilege_expansion": false,
    "blind_retry": false,
    "identical_irreversible_retry": false,
    "sudoers_mutation": false,
    "interactive_sudo": false,
    "unscoped_root_shell": false
  },
  "mandatory_hold_classes": [
    "DATA_CORRUPTION",
    "PROTECTED_HASH_MISMATCH",
    "UNEXPECTED_PARTITION_GEOMETRY",
    "UNRESOLVED_BOOT_SAFETY",
    "SCOPE_DRIFT",
    "AUTHORITY_CHANGE",
    "PRIVILEGE_EXPANSION",
    "NEW_DESTRUCTIVE_SCOPE",
    "LEGAL_OR_LICENSE_GATE",
    "SECRET_OR_CREDENTIAL_EXPOSURE",
    "UNKNOWN"
  ],
  "human_reprompt_only_if": [
    "SCOPE_EXPANSION",
    "NEW_IRREVERSIBLE_SCOPE",
    "LEGAL_LICENSE_GATE",
    "AUTHORITY_CHANGE",
    "UNRESOLVED_SAFETY_BOUNDARY"
  ],
  "evidence_requirements": [
    "source_run_id",
    "source_job_id",
    "source_commit",
    "exact_error",
    "root_cause",
    "patch_diff_or_patch_hash",
    "static_validation",
    "g23_reference",
    "g24_reference",
    "rerun_reference",
    "non_regression_result"
  ],
  "sudo_policy": {
    "capability": "PERMANENT_NONINTERACTIVE_SUDO_ALREADY_AUTHORIZED",
    "invocation": "sudo -n",
    "rule": "USE_WHEN_A_CURRENTLY_AUTHORIZED_OPERATION_CROSSES_AN_EXISTING_ROOT_OWNED_OR_PRIVILEGED_FILESYSTEM_BOUNDARY",
    "privilege_expansion": false,
    "password_prompt_forbidden": true,
    "sudoers_mutation_forbidden_without_new_scope": true,
    "apc_scope_preserved": true,
    "evidence_outputs_should_return_to_runner_owner_when_required": true
  },
  "similar_bug_authorization": {
    "status": "AUTHORIZED",
    "scope": "ANY_DETERMINISTIC_BUG_OF_THE_SAME_NON_EXPANDING_IMPLEMENTATION_NATURE_DURING_CURRENT_MISSION",
    "examples": [
      "missing sudo -n on an already-authorized privileged read/verification",
      "root-owned candidate tree consumed by an unprivileged verifier",
      "artifact/path/name mismatch",
      "sparse-checkout dependency omission",
      "quoting/environment/wiring defect"
    ],
    "must_hold_if": [
      "scope_expands",
      "privileges_expand",
      "new_destructive_action_is_needed",
      "protected_hash_mismatch",
      "data_corruption",
      "boot_safety_unresolved",
      "authority_changes",
      "legal_or_license_gate",
      "unknown_root_cause"
    ]
  },
  "bug_governance_v2": {
    "status": "AUTHORIZED_WITHIN_CURRENT_MISSION_SCOPE",
    "authority": "Louksna.md",
    "assurance": "PUAC2.md",
    "principle": "BUG_COMPLEXITY_ALONE_DOES_NOT_REQUIRE_HUMAN_REPROMPT; SCOPE, AUTHORITY, IRREVERSIBILITY, SAFETY, LEGALITY AND EVIDENCE DETERMINE THE GATE.",
    "tiers": {
      "T1_BANAL_DETERMINISTIC": {
        "autonomous": true,
        "pipeline": [
          "CAPTURE_FAILURE",
          "CLASSIFY",
          "ROOT_CAUSE",
          "MINIMUM_DELTA",
          "STATIC_OR_TARGETED_TEST",
          "AUDIT",
          "TRACE",
          "G23",
          "G24",
          "RERUN_FAILED_OR_DOWNSTREAM_ONLY",
          "NON_REGRESSION",
          "CONTINUE"
        ]
      },
      "T2_COMPLEX_BOUNDED": {
        "autonomous": true,
        "preconditions": [
          "CURRENT_MISSION_SCOPE_UNCHANGED",
          "AUTHORITY_UNCHANGED",
          "PRIVILEGE_ENVELOPE_UNCHANGED",
          "NO_NEW_IRREVERSIBLE_SCOPE",
          "NO_LEGAL_OR_LICENSE_GATE",
          "VERIFIED_CHECKPOINT_OR_PROVEN_SAFE_STATE",
          "EVIDENCE_PRESERVED"
        ],
        "pipeline": [
          "CAPTURE_FAILURE",
          "BUILD_INCIDENT_RECORD",
          "FORM_COMPETING_HYPOTHESES",
          "MC07_SECOND_ORDER_IMPACT",
          "MC08_SELF_AUDIT",
          "IDENTIFY_LAST_VERIFIED_CHECKPOINT",
          "DESIGN_MINIMUM_BOUNDED_REMEDIATION",
          "G23_REVIEW_OF_CONSEQUENTIAL_REMEDIATION_PLAN",
          "CHECKPOINT",
          "EXECUTE_BOUNDED_DELTA",
          "POST_VALIDATE",
          "TEST_NON_REGRESSION",
          "AUDIT",
          "TRACE",
          "G23_STATE_VALIDATION",
          "G24_EXACT_SCOPE_CERTIFICATION",
          "CONTINUE"
        ],
        "blind_retry": false,
        "certification_inheritance": false
      },
      "T3_HUMAN_GATE": {
        "autonomous": false,
        "triggers": [
          "SCOPE_EXPANSION",
          "NEW_IRREVERSIBLE_SCOPE",
          "AUTHORITY_CHANGE",
          "PRIVILEGE_EXPANSION",
          "LEGAL_LICENSE_GATE",
          "UNRESOLVED_SAFETY_BOUNDARY",
          "PROTECTED_HASH_MISMATCH_WITHOUT_PROVEN_CAUSE",
          "DATA_CORRUPTION_WITHOUT_PROVEN_SAFE_RECOVERY",
          "UNKNOWN_AFTER_BOUNDED_DIAGNOSIS"
        ]
      }
    },
    "global_invariants": [
      "DO_NOT_REPEAT_CERTIFIED_WORK",
      "DO_NOT_REPEAT_HASH_VERIFIED_BULK_COPY",
      "DO_NOT_REPEAT_PARTITION_MIGRATION",
      "USE_EXISTING_SUDO_N_WHEN_REQUIRED_BY_ALREADY_AUTHORIZED_SCOPE",
      "G23_AND_G24_REMAIN_DISTINCT",
      "G23_PRECEDES_G24",
      "NO_SILENT_CERTIFICATION_PROPAGATION",
      "APPEND_ONLY_INCIDENT_HISTORY",
      "FAIL_CLOSED_ON_UNKNOWN_OR_CONFLICT"
    ]
  }
}
