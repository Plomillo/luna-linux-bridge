# Copy to .env and replace both password placeholders with unique random secrets.
# Suggested generation on Linux/macOS: openssl rand -hex 32
KESTRA_DB_PASSWORD=REPLACE_WITH_A_UNIQUE_64_HEX_CHARACTER_SECRET
KESTRA_ADMIN_EMAIL=admin@example.com
KESTRA_ADMIN_PASSWORD=REPLACE_WITH_ANOTHER_UNIQUE_64_HEX_CHARACTER_SECRET
