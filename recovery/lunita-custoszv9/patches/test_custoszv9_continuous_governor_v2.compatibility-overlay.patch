+class CompatibilityRecoveryRouteTests(unittest.TestCase):
+    def _fixture(self, root, *, include_numpy_failure=True):
+        state = root / "state"
+        state.mkdir()
+        receipt = state / "failed-install.json"
+        log = state / "failed-install.log"
+        log.write_text(
+            "Collecting numpy~=1.26.4\nDownloading numpy-1.26.4.tar.gz\n"
+            + ("error: metadata-generation-failed\n" if include_numpy_failure else "network timeout\n"),
+            encoding="utf-8",
+        )
+        receipt.write_text(json.dumps({
+            "returncode": 1,
+            "argv": ["/tmp/venvs/llama-cpp-b10819-py313/bin/python", "-m", "pip", "install", "numpy~=1.26.4"],
+        }), encoding="utf-8")
+        lane = {
+            "stage": "BLOCKED_ENVIRONMENT_PROVISIONING",
+            "venv_python": "/tmp/venvs/llama-cpp-b10819-py313/bin/python",
+            "compatibility_v2_attempts": 0,
+            "attempts": [{
+                "stage": "ENV_INSTALL_FALLBACK_RUNNING",
+                "status": "FAIL",
+                "returncode": 1,
+                "receipt_path": str(receipt),
+                "log_path": str(log),
+            }],
+        }
+        return state, lane
+
+    def test_python313_legacy_numpy_source_build_selects_different_route(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            state_dir, lane = self._fixture(pathlib.Path(tmp))
+            route = getattr(governor, "_compatibility_recovery_route", lambda *_: None)(lane, state_dir)
+            self.assertIsNotNone(route)
+            self.assertEqual(route["next_stage"], "PROVISION_ENV")
+            self.assertEqual(route["reason_code"], "PYTHON313_NUMPY_LEGACY_SDIST_INCOMPATIBLE")
+            self.assertEqual(route["numpy_requirement"], "numpy==2.2.6")
+            self.assertIn("metadata-generation-failed", route["evidence"]["failure_signature"])
+            self.assertEqual(lane["stage"], "BLOCKED_ENVIRONMENT_PROVISIONING")
+
+    def test_unrelated_failure_does_not_trigger_numpy_compatibility_route(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            state_dir, lane = self._fixture(pathlib.Path(tmp), include_numpy_failure=False)
+            route = getattr(governor, "_compatibility_recovery_route", lambda *_: None)(lane, state_dir)
+            self.assertIsNone(route)
+
+    def test_tick_moves_terminal_block_to_compatibility_recovery_without_launching_a_job(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            root = pathlib.Path(tmp)
+            operator = root / "operator"
+            runtime = operator / "CUSTOSZ_CONTINUITY_V1"
+            state = runtime / "state"
+            outputs = state / "worker_outputs"
+            outputs.mkdir(parents=True)
+            mission = operator / "MISION1.txt"
+            mission.write_text(
+                "Cajita de Luna: máxima prioridad operativa\n"
+                "3.3. cuantización, poda y optimización\n"
+                "5. segundo frente: cierre de Lunita\n"
+                "validación independiente y certificación\n",
+                encoding="utf-8",
+            )
+            mission_sha = hashlib.sha256(mission.read_bytes()).hexdigest()
+            log = outputs / "failed.log"
+            log.write_text(
+                "Collecting numpy~=1.26.4\nDownloading numpy-1.26.4.tar.gz\n"
+                "error: metadata-generation-failed\n",
+                encoding="utf-8",
+            )
+            receipt = outputs / "failed.json"
+            receipt.write_text(json.dumps({
+                "returncode": 1,
+                "argv": ["/tmp/llama-cpp-b10819-py313/bin/python", "-m", "pip", "install", "numpy~=1.26.4"],
+            }), encoding="utf-8")
+            lane = {
+                "schema": "CUSTOSZ_CAJITA_PRIORITY_LANE_STATE/1.0",
+                "mission_sha256": mission_sha,
+                "stage": "BLOCKED_ENVIRONMENT_PROVISIONING",
+                "venv_python": "/tmp/llama-cpp-b10819-py313/bin/python",
+                "fallback_environment_failed": True,
+                "fallback_env_install_attempts": 1,
+                "compatibility_recovery_attempts": 0,
+                "job": None,
+                "attempts": [{
+                    "stage": "ENV_INSTALL_FALLBACK_RUNNING", "status": "FAIL",
+                    "returncode": 1, "receipt_path": str(receipt), "log_path": str(log),
+                }],
+                "last_progress_utc": "2026-10-20T00:00:00Z",
+                "certification": "NOT_GRANTED",
+            }
+            (state / "cajita_priority_lane.json").write_text(json.dumps(lane), encoding="utf-8")
+            result = governor.tick_cajita_priority_lane(
+                state, root / "Cajita", mission_sha
+            )
+            after = json.loads((state / "cajita_priority_lane.json").read_text(encoding="utf-8"))
+            self.assertEqual(result["status"], "CAJITA_COMPATIBILITY_RECOVERY_ROUTE_SELECTED")
+            self.assertEqual(after["stage"], "PROVISION_ENV")
+            self.assertEqual(after["compatibility_recovery_attempts"], 1)
+            self.assertIsNone(after["job"])
+            self.assertFalse(after["certification"] == "CERTIFIED")
+            self.assertEqual(after["attempts"][-1]["status"], "ALTERNATIVE_ROUTE_SELECTED")
+            self.assertEqual(after["attempts"][0]["status"], "FAIL")
+
+    def test_route_is_not_replayed_after_a_compatibility_attempt(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            state_dir, lane = self._fixture(pathlib.Path(tmp))
+            lane["compatibility_recovery_attempts"] = 1
+            route = getattr(governor, "_compatibility_recovery_route", lambda *_: None)(lane, state_dir)
+            self.assertIsNone(route)
+
+
 if __name__ == "__main__":
     unittest.main(verbosity=2)
