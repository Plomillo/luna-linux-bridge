+def reconcile_historical_completions(state):
+    """Append adjudications for old false-PASS rows without deleting or rewriting history."""
+    prior = state.setdefault("historical_completion_adjudications", [])
+    seen = {(x.get("step_id"), x.get("result_sha256")) for x in prior}
+    changed = False
+    for row in state.get("completed_steps", []):
+        step_id = row.get("step_id")
+        digest = row.get("result_sha256")
+        if (step_id, digest) in seen:
+            continue
+        path = pathlib.Path(row.get("result_path", ""))
+        receipt = load(path, {}) or {}
+        evidence_ok = (path.is_file() and bool(digest) and sha(path) == digest
+                       and receipt.get("mission_sha256") == MISSION_SHA
+                       and receipt.get("step_id") == step_id)
+        accepted = evidence_ok and completion_admitted(step_id, receipt)
+        independent_ok = independent_validation_state(receipt) == "PASS"
+        reasons = []
+        if not evidence_ok:
+            reasons.append("RESULT_RECEIPT_MISSING_OR_HASH_BINDING_INVALID")
+        elif not accepted:
+            reasons.append("LEGACY_COMPLETION_NOT_ADMITTED_BY_FAIL_CLOSED_ALLOWLIST")
+        if row.get("independent_validation") == "PASS" and not independent_ok:
+            reasons.append("HISTORICAL_INDEPENDENT_VALIDATION_CLAIM_HAS_NO_BOUND_RECEIPT")
+        if reasons:
+            prior.append({
+                "step_id": step_id,
+                "result_path": str(path),
+                "result_sha256": digest,
+                "historical_row_preserved": True,
+                "historical_row_status": row.get("status"),
+                "historical_independent_validation": row.get("independent_validation"),
+                "adjudication": "PENDING_REVALIDATION",
+                "reasons": reasons,
+                "captured_at_utc": utc(),
+            })
+            seen.add((step_id, digest))
+            changed = True
+    if len(prior) > 500:
+        del prior[:-500]
+    return changed
