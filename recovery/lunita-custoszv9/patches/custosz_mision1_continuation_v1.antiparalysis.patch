+def completion_admitted(step_id, result):
+    """Fail closed: a status absent from the per-step allowlist is never success."""
+    if not isinstance(result, dict) or result.get("step_completion") is False:
+        return False
+    status = result.get("status")
+    if not isinstance(status, str) or not status:
+        return False
+    normalized = status.upper()
+    if any(marker in normalized for marker in BLOCKED_STATUS_MARKERS):
+        return False
+    if status not in STEP_SUCCESS_STATUS_ALLOWLIST.get(step_id, set()):
+        return False
+    if step_id in STRICT_STEP_COMPLETION_IDS:
+        return result.get("step_completion") is True
+    # Compatibility is limited to exact, named legacy success statuses above.
+    return result.get("step_completion") is not False
+
+
+def independent_validation_state(result):
+    """Never infer independent validation from absence of a failure-looking status."""
+    digest = result.get("independent_report_sha256") if isinstance(result, dict) else None
+    valid_digest = (isinstance(digest, str) and len(digest) == 64
+                    and all(ch in "0123456789abcdef" for ch in digest.lower()))
+    if (isinstance(result, dict)
+        and result.get("status") == "BETA_OPERATIONAL_CERTIFIED"
+        and result.get("independent_validation") == "PASS"
+        and valid_digest):
+        return "PASS"
+    return "PENDING"
+
