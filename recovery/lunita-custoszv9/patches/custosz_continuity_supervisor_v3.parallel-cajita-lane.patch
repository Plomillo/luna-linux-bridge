+def tick_parallel_cajita_lane(continuation_already_ticked):
+    """Advance Cajita independently when the serial Lunita continuation is in backoff."""
+    if continuation_already_ticked:
+        return {"status": "CAJITA_LANE_ALREADY_TICKED_BY_CONTINUATION", "did_work": False}
+    try:
+        lane = continuation.continuous_governor.tick_cajita_priority_lane(
+            ST, pathlib.Path(core.CAJ), MISSION_SHA
+        )
+        if lane.get("did_work"):
+            continuation.write_result("CAJITA_PRIORITY_LANE", {
+                "status": lane.get("status", "UNKNOWN"),
+                "parallel_lane": lane,
+                "step_completion": True,
+                "mission_completion_claim": False,
+                "certification": "NOT_GRANTED",
+            })
+        return lane
+    except Exception as exc:
+        fault = None
+        try:
+            fault = recovery.record_fault("cajita_priority_lane", exc, traceback.format_exc())
+        except Exception:
+            pass
+        lane_error = {
+            "status": "CAJITA_LANE_RECOVERY_REQUIRED",
+            "did_work": False,
+            "error_type": type(exc).__name__,
+            "error": str(exc)[:1200],
+            "fault": fault,
+            "next_action": "Preserve the Cajita checkpoint and repair its isolated lane; do not block Lunita continuation.",
+            "mission_completion_claim": False,
+            "certification": "NOT_GRANTED",
+        }
+        try:
+            continuation.write_result("CAJITA_PRIORITY_LANE_ERROR", lane_error)
+        except Exception:
+            pass
+        return lane_error
+
