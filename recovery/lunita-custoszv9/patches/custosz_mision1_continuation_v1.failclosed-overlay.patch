+def completion_admitted(step_id, result):
+    """Fail closed: only exact per-step success statuses can advance the cursor."""
+    if not isinstance(result, dict) or result.get("step_completion") is False:
+        return False
+    status = result.get("status")
+    if not isinstance(status, str) or not status:
+        return False
+    if step_id == "S30_G06_AUTOMATIC_VERSIONED_REBUILD_FALLBACK":
+        # Registering a verified, isolated rebuild candidate is useful progress even
+        # when its remaining build inputs are pending. It is not certification.
+        candidate = result.get("rebuild_candidate")
+        valid_waiting_states = {
+            "WAITING_FOR_VERIFIED_UBUNTU_BASE_INPUT",
+            "WAITING_FOR_RUNTIME_REBUILD_INPUTS",
+        }
+        if status in valid_waiting_states and isinstance(candidate, dict):
+            candidate_path = str(candidate.get("candidate_path", ""))
+            rootfs_path = str(candidate.get("candidate_rootfs", ""))
+            return (
+                candidate.get("status") == status
+                and candidate.get("candidate_created") is True
+                and candidate.get("candidate_id") == "G06_REBUILD_CANDIDATE_R1"
+                and candidate_path.endswith("/G06_REBUILD_CANDIDATE_R1")
+                and rootfs_path.endswith("/G06_REBUILD_CANDIDATE_R1/rootfs")
+                and isinstance(candidate.get("base_archive_verified"), bool)
+                and candidate.get("frozen_g06_mutated") is False
+                and candidate.get("canonical_g08_bindings_mutated") is False
+                and result.get("frozen_g06_mutated") is False
+                and result.get("canonical_g08_bindings_mutated") is False
+                and result.get("mission_completion_claim") is False
+                and result.get("certification") == "NOT_GRANTED"
+            )
+    if any(marker in status.upper() for marker in BLOCKED_STATUS_MARKERS):
+        return False
+    if status not in STEP_SUCCESS_STATUS_ALLOWLIST.get(step_id, set()):
+        return False
+    if step_id in STRICT_STEP_COMPLETION_IDS:
+        if result.get("step_completion") is not True:
+            return False
+        if step_id == "S32_INDEPENDENT_BETA_VALIDATION_AND_RECEIPT":
+            return independent_validation_state(result) == "PASS"
+    return result.get("step_completion") is not False
+
+
+def independent_validation_state(result):
+    """PASS requires a separate, schema-valid report whose bytes match its digest."""
+    if not isinstance(result, dict):
+        return "PENDING"
+    if result.get("status") != "BETA_OPERATIONAL_CERTIFIED" or result.get("independent_validation") != "PASS":
+        return "PENDING"
+    report_text, expected = result.get("independent_report_path"), result.get("independent_report_sha256")
+    runtime_sha = result.get("runtime_report_sha256")
+    if not isinstance(report_text, str) or not isinstance(expected, str) or len(expected) != 64:
+        return "PENDING"
+    report_path = pathlib.Path(report_text)
+    if not report_path.is_file() or sha(report_path) != expected:
+        return "PENDING"
+    report = load(report_path, {}) or {}
+    checks = report.get("checks")
+    if (report.get("schema") != "CUSTOSZ_LUNITA_BETA_INDEPENDENT_VALIDATION/1.0"
+        or report.get("status") != "PASS_INDEPENDENT_VALIDATION"
+        or report.get("runtime_report_sha256") != runtime_sha
+        or not isinstance(checks, dict) or not checks
+        or any(not isinstance(v, dict) or v.get("status") != "PASS" or v.get("returncode", 0) != 0 for v in checks.values())
+        or report.get("frozen_g06_mutated") is not False
+        or report.get("canonical_g08_bindings_mutated") is not False):
+        return "PENDING"
+    return "PASS"
+
+
+def reconcile_historical_completions(state):
+    """Append adjudications for legacy false-PASS rows; preserve original history byte-for-byte."""
+    prior = state.setdefault("historical_completion_adjudications", [])
+    seen = {(x.get("step_id"), x.get("result_sha256")) for x in prior}
+    changed = False
+    for row in state.get("completed_steps", []):
+        step_id, digest = row.get("step_id"), row.get("result_sha256")
+        if (step_id, digest) in seen:
+            continue
+        result_path = pathlib.Path(row.get("result_path", ""))
+        receipt = load(result_path, {}) or {}
+        evidence_ok = (result_path.is_file() and bool(digest) and sha(result_path) == digest
+                       and receipt.get("mission_sha256") == MISSION_SHA
+                       and receipt.get("step_id") == step_id)
+        reasons = []
+        if not evidence_ok:
+            reasons.append("RESULT_RECEIPT_MISSING_OR_HASH_BINDING_INVALID")
+        elif not completion_admitted(step_id, receipt):
+            reasons.append("LEGACY_COMPLETION_NOT_ADMITTED_BY_FAIL_CLOSED_ALLOWLIST")
+        if row.get("independent_validation") == "PASS" and independent_validation_state(receipt) != "PASS":
+            reasons.append("HISTORICAL_INDEPENDENT_VALIDATION_CLAIM_HAS_NO_BOUND_RECEIPT")
+        if reasons:
+            prior.append({
+                "step_id": step_id, "result_path": str(result_path), "result_sha256": digest,
+                "historical_row_preserved": True, "historical_row_status": row.get("status"),
+                "historical_independent_validation": row.get("independent_validation"),
+                "adjudication": "PENDING_REVALIDATION", "reasons": reasons, "captured_at_utc": utc(),
+            })
+            seen.add((step_id, digest))
+            changed = True
+    if len(prior) > 500:
+        del prior[:-500]
+    return changed
+
