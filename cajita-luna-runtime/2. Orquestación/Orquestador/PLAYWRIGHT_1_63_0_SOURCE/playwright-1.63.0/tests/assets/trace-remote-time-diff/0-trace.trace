Hub","style":"display:block"},"65k+"]]]]],["BR"],["MAIN",{},["BR"],["BR"],["DIV",{"style":"text-align:center"},["IMG",{"__playwright_current_src__":"https://playwright.dev/img/logos/Browsers.png","src":"img/logos/Browsers.png","width":"40%","alt":"Browsers (Chromium, Firefox, WebKit)"}]],["SECTION",{"class":"features_keug"},["DIV",{"class":"container"},["DIV",{"class":"row"},["DIV",{"class":"col col--6","style":"margin-top:40px"},["H3",{},"Any browser • Any platform • One API"],["DIV",{},["P",{},["B",{},"Cross-browser."]," Playwright supports all modern rendering engines including Chromium, WebKit, and Firefox."],["P",{},["B",{},"Cross-platform."]," Test on Windows, Linux, and macOS, locally or on CI, headless or headed."],["P",{},["B",{},"Cross-language."]," Use the Playwright API in ",["A",{"href":"https://playwright.dev/docs/intro"},"TypeScript"],", ",["A",{"href":"https://playwright.dev/docs/intro"},"JavaScript"],", ",["A",{"href":"https://playwright.dev/python/docs/intro"},"Python"],", ",["A",{"href":"https://playwright.dev/dotnet/docs/intro"},".NET"],", ",["A",{"href":"https://playwright.dev/java/docs/intro"},"Java"],"."],["P",{},["B",{},"Test Mobile Web."]," Native mobile emulation of Google Chrome for Android and Mobile Safari. The same rendering engine works on your Desktop and in the Cloud."]]],["DIV",{"class":"col col--6","style":"margin-top:40px"},["H3"],["DIV"]],["DIV",{"class":"col col--6","style":"margin-top:40px"},["H3"],["DIV"]],["DIV",{"class":"col col--6","style":"margin-top:40px"},["H3",{},"Resilient • No flaky tests"],["DIV",{},["P",{},["B",{},"Auto-wait."]," Playwright waits for elements to be actionable prior to performing actions. It also has a rich set of introspection events. The combination of the two eliminates the need for artificial timeouts - the primary cause of flaky tests."],["P",{},["B",{},"Web-first assertions."]," Playwright assertions are created specifically for the dynamic web. Checks are automatically retried until the necessary conditions are met."],["P",{},["B",{},"Tracing."]," Configure test retry strategy, capture execution trace, videos, screenshots to eliminate flakes."]]],["DIV",{"class":"col col--6","style":"margin-top:40px"},["H3",{},"No trade-offs • No limits"],["DIV",{},["P",{},"Browsers run web content belonging to different origins in different processes. Playwright is aligned with the modern browsers architecture and runs tests out-of-process. This makes Playwright free of the typical in-process test runner limitations."],["P",{},["B",{},"Multiple everything."]," Test scenarios that span multiple ",["B",{},"tabs"],", multiple ",["B",{},"origins"]," and multiple ",["B",{},"users"],". Create scenarios with different contexts for different users and run them against your server, all in one test."],["P",{},["B",{},"Trusted events."]," Hover elements, interact with dynamic controls, produce trusted events. Playwright uses real browser input pipeline indistinguishable from the real user."],["P",{},["B",{},"Test frames, pierce Shadow DOM."]," Playwright selectors pierce shadow DOM and allow entering frames seamlessly."]]],["DIV",{"class":"col col--6","style":"margin-top:40px"},["H3"],["DIV"]],["DIV",{"class":"col col--6","style":"margin-top:40px"},["H3"],["DIV"]],["DIV",{"class":"col col--6","style":"margin-top:40px"},["H3",{},"Full isolation • Fast execution"],["DIV",{},["P",{},["B",{},"Browser contexts."]," Playwright creates a browser context for each test. Browser context is equivalent to a brand new browser profile. This delivers full test isolation with zero overhead. Creating a new browser context only takes a handful of milliseconds."],["P",{},["B",{},"Log in once."]," Save the authentication state of the context and reuse it in all the tests. This bypasses repetitive log-in operations in each test, yet delivers full isolation of independent tests."]]],["DIV",{"class":"col col--6","style":"margin-top:40px"},["H3",{},"Powerful Tooling"],["DIV",{},["P",{},["B",{},["A",{"href":"docs/codegen"},"Codegen."]]," Generate tests by recording your actions. Save them into any language."],["P",{},["B",{},["A",{"href":"docs/debug#playwright-inspector"},"Playwright inspector."]]," Inspect page, generate selectors, step through the test execution, see click points, explore execution logs."],["P",{},["B",{},["A",{"href":"docs/trace-viewer-intro"},"Trace Viewer."]]," Capture all the information to investigate the test failure. Playwright trace contains test execution screencast, live DOM snapshots, action explorer, test source, and many more."]]]]]],["SECTION",{"class":"logosSection_gMWS"},["DIV",{"class":"container"},["DIV",{"class":"row"},["DIV",{"class":"col col--12 logosColumn_GJVT"},["H2",{},"Chosen by companies and open source projects"],["UL",{"class":"logosList_zAAF"},["LI",{},["A",{"href":"https://code.visualstudio.com","target":"_blank","rel":"noreferrer noopener"},["IMG",{"__playwright_current_src__":"https://playwright.dev/img/logos/VSCode.png","src":"img/logos/VSCode.png","alt":"VS Code"}]]],["LI",{},["A",{"href":"https://bing.com","target":"_blank","rel":"noreferrer noopener"},["IMG",{"__playwright_current_src__":"https://playwright.dev/img/logos/Bing.png","src":"img/logos/Bing.png","alt":"Bing"}]]],["LI",{},["A",{"href":"https://outlook.com","target":"_blank","rel":"noreferrer noopener"},["IMG",{"__playwright_current_src__":"https://playwright.dev/img/logos/Outlook.png","src":"img/logos/Outlook.png","alt":"Outlook"}]]],["LI",{},["A",{"href":"https://www.hotstar.com/","target":"_blank","rel":"noreferrer noopener"},["IMG",{"__playwright_current_src__":"https://playwright.dev/img/logos/DHotstar.jpg","src":"img/logos/DHotstar.jpg","alt":"Disney+ Hotstar"}]]],["LI",{},["A",{"href":"https://github.com/mui-org/material-ui","target":"_blank","rel":"noreferrer noopener"},["IMG",{"__playwright_current_src__":"https://playwright.dev/img/logos/MUI.png","src":"img/logos/MUI.png","alt":"Material UI"}]]],["LI",{},["A",{"href":"https://github.com/ing-