{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://louksna.local/schemas/EXTERNAL_EVALUATOR_RECORD.schema.json",
  "title": "External Independent Evaluator Record for PUAC.C27",
  "type": "object",
  "required": [
    "schema",
    "artifact_id",
    "candidate_digest",
    "evaluator",
    "independence",
    "evaluation",
    "provenance"
  ],
  "properties": {
    "schema": {
      "const": "EXTERNAL_EVALUATOR_RECORD/1.0"
    },
    "artifact_id": {
      "const": "META_ECOSYSTEM_CONTROL_PLANE_V1"
    },
    "candidate_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evaluator": {
      "type": "object",
      "required": [
        "evaluator_id",
        "provider",
        "role"
      ],
      "properties": {
        "evaluator_id": {
          "type": "string",
          "minLength": 3
        },
        "provider": {
          "type": "string",
          "minLength": 2
        },
        "role": {
          "const": "SECOND_INDEPENDENT_EVALUATOR"
        }
      },
      "additionalProperties": true
    },
    "independence": {
      "type": "object",
      "required": [
        "not_candidate_builder",
        "not_material_worker",
        "read_only_candidate",
        "repair_performed",
        "can_modify_candidate",
        "conflict_disclosure"
      ],
      "properties": {
        "not_candidate_builder": {
          "const": true
        },
        "not_material_worker": {
          "const": true
        },
        "read_only_candidate": {
          "const": true
        },
        "repair_performed": {
          "const": false
        },
        "can_modify_candidate": {
          "const": false
        },
        "conflict_disclosure": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "evaluation": {
      "type": "object",
      "required": [
        "result",
        "claims_reviewed",
        "findings",
        "limitations"
      ],
      "properties": {
        "result": {
          "enum": [
            "PASS",
            "HOLD",
            "FAIL"
          ]
        },
        "claims_reviewed": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "required": [
        "issued_at",
        "source_system",
        "source_record_id",
        "source_record_uri",
        "immutable_or_signed_proof"
      ],
      "properties": {
        "issued_at": {
          "type": "string",
          "minLength": 10
        },
        "source_system": {
          "type": "string",
          "minLength": 2
        },
        "source_record_id": {
          "type": "string",
          "minLength": 3
        },
        "source_record_uri": {
          "type": "string",
          "minLength": 3
        },
        "immutable_or_signed_proof": {
          "type": "string",
          "minLength": 3
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
