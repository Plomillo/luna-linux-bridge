      "endpoint": "https://router.huggingface.co/v1/chat/completions",
      "credential_env": "HF_TOKEN",
      "model": "openai/gpt-oss-120b",
      "cost_gate": "OWNER_ACKNOWLEDGES_USAGE_BILLING"
    }
  }
}
