#!/usr/bin/make -f
export DH_VERBOSE=1

%:
	dh $@

override_dh_auto_configure:
	python3 -m compileall -q bridge

override_dh_auto_test:
	python3 -m unittest bridge/tests/test_mtls_gateway.py
	python3 -m unittest bridge/tests/test_lrb_core.py
	python3 -m unittest bridge/tests/test_live_link.py
	python3 -m unittest bridge/tests/test_release_policy.py

override_dh_auto_build:
	python3 scripts/build

override_dh_auto_install:
	install -d debian/louksna-linux-bridge/usr/lib/louksna/bridge
	cp -a bridge/*.py debian/louksna-linux-bridge/usr/lib/louksna/bridge/
	cp -a bridge/*.json debian/louksna-linux-bridge/usr/lib/louksna/bridge/
	install -m 0750 scripts/provision-mtls-local.sh debian/louksna-linux-bridge/usr/lib/louksna/bridge/provision-mtls-local.sh
	install -d debian/louksna-linux-bridge/usr/share/louksna/deploy
	cp -a bridge/deploy/*.service.in bridge/deploy/*.timer.in debian/louksna-linux-bridge/usr/share/louksna/deploy/
	install -d debian/louksna-linux-bridge/usr/share/louksna
	cp bridge/MTLS_READONLY_GATEWAY.md bridge/LIVE_TRANSPORT.md bridge/README.md debian/louksna-linux-bridge/usr/share/louksna/
	install -d debian/louksna-linux-bridge/lib/systemd/system
	sed -e 's#@REVIEWED_PROJECT_ROOT@#/usr/lib/louksna#' -e 's#@ROOT_PROVISIONED_MTLS_CONFIG@#/etc/louksna/remote-bridge/mtls.json#' -e 's#@OWNER_PRIVATE_STATE@#/var/lib/louksna/remote-bridge#' -e 's#@OWNER_CHOSEN_PORT@#8443#' bridge/deploy/louksna-mtls-readonly.service.in > debian/louksna-linux-bridge/lib/systemd/system/louksna-mtls-readonly.service

# The service requires an owner-provisioned mTLS config and private key.
# Never enable or start it as a side effect of installing the package.
override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start
