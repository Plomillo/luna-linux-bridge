{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "G23 Independence Evidence",
  "type": "object",
  "required": [
    "schema",
    "status",
    "evaluator_identity",
    "evaluator_role",
    "organization_or_system",
    "evaluated_at_utc",
    "candidate_digest_sha256",
    "artifact_zip_sha256",
    "distinct_evaluator_identity",
    "write_access_to_candidate",
    "repair_allowed",
    "validator_mutation_allowed",
    "conflict_of_interest",
    "method",
    "checks",
    "findings",
    "limitations",
    "decision",
    "signature_or_attestation_reference"
  ],
  "properties": {
    "schema": {
      "const": "G23_INDEPENDENCE_EVIDENCE/1.0"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "HOLD"
      ]
    },
    "evaluator_identity": {
      "type": "string",
      "minLength": 1
    },
    "evaluator_role": {
      "type": "string",
      "minLength": 1
    },
    "organization_or_system": {
      "type": "string",
      "minLength": 1
    },
    "evaluated_at_utc": {
      "type": "string",
      "minLength": 1
    },
    "candidate_digest_sha256": {
      "const": "3cf52cc4d6d114c2f201bf1f835217e605538987aa7b2f1d792b13d24a349bf4"
    },
    "artifact_zip_sha256": {
      "const": "1141ded7192fafbaafca86c403b83c9cdf792d11fa0b85bb9123ede7f17d8d03"
    },
    "distinct_evaluator_identity": {
      "type": "boolean"
    },
    "write_access_to_candidate": {
      "type": "boolean"
    },
    "repair_allowed": {
      "type": "boolean"
    },
    "validator_mutation_allowed": {
      "type": "boolean"
    },
    "conflict_of_interest": {
      "type": "string"
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "checks": {
      "type": "array",
      "minItems": 1
    },
    "findings": {
      "type": "array"
    },
    "limitations": {
      "type": "array"
    },
    "decision": {
      "enum": [
        "INDEPENDENCE_ESTABLISHED_FOR_G23",
        "INDEPENDENCE_NOT_ESTABLISHED"
      ]
    },
    "signature_or_attestation_reference": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
