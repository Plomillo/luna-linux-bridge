{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "LOUKSNA_CONSULTA_ENVELOPE/1.0",
  "type": "object",
  "required": [
    "schema",
    "consulta_id",
    "kind",
    "source_path",
    "source_sha256",
    "source_bytes",
    "execution_authorized",
    "mutation_authorized",
    "state",
    "authority",
    "created_at_utc"
  ],
  "properties": {
    "schema": {
      "const": "LOUKSNA_CONSULTA_ENVELOPE/1.0"
    },
    "consulta_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "CONSULTA"
    },
    "source_path": {
      "type": "string",
      "minLength": 1
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "execution_authorized": {
      "const": false
    },
    "mutation_authorized": {
      "const": false
    },
    "state": {
      "enum": [
        "RECEIVED",
        "ROUTED",
        "ANSWERED",
        "HOLD",
        "REJECTED"
      ]
    },
    "authority": {
      "const": "Louksna.md"
    },
    "created_at_utc": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
